# Application Environment
VITE_APP_NAME=PA_ValueTech
VITE_APP_DESCRIPTION=Admin_Management_Portal
VITE_ENVIRONMENT=production

# API Configuration
VITE_SERVER_PORT=5000
VITE_SERVER_BASE_URL=http://localhost
VITE_API_TIMEOUT=30000
VITE_API_VERSION=api/v1
VITE_ENV=production



# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true

# Third-party Services
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_GTAG_ID=UA-XXXXXXXXX-X

# Authentication
VITE_AUTH_COOKIE_NAME=auth
VITE_AUTH_TOKEN_STORAGE=localStorage

# Logging Level (development, staging, production)
VITE_LOG_LEVEL=error
