# Application Environment
VITE_APP_NAME=PA ValueTech
VITE_APP_DESCRIPTION=Admin Management Portal
NODE_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.valuetech.com
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true

# Third-party Services
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_GTAG_ID=UA-XXXXXXXXX-X

# Authentication
VITE_AUTH_COOKIE_NAME=__auth
VITE_AUTH_TOKEN_STORAGE=localStorage

# Logging Level (development, staging, production)
VITE_LOG_LEVEL=error
