#application configuration
VITE_APP_NAME=PA_ValueTech
VITE_APP_DESCRIPTION=Admin_Management_Portal
VITE_ENVIRONMENT=production

# Backend Configuration
# General backend origin - used by the Vite dev-server proxy (vite.config.js)
# and available app-wide via CREDENTIALS.BACKEND_URL. No trailing slash.
# Append :PORT here if you have a fixed port, or leave VITE_SERVER_PORT
# empty/unset when the URL already includes one.
VITE_BACKEND_URL=https://api.example.com
VITE_SERVER_PORT=

# Full API root used exclusively by src/constants/apiConfig.js to build every
# endpoint URL. No trailing slash (one is stripped automatically if present).
VITE_API_URL=https://api.example.com/api/v1

VITE_API_TIMEOUT=30000
VITE_ENV=production

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true

# Authentication
VITE_AUTH_COOKIE_NAME=auth
VITE_AUTH_TOKEN_STORAGE=localStorage

# Logging Level (development, staging, production)
VITE_LOG_LEVEL=error

# Optional: error tracking DSN, read in src/utils/logger.js
VITE_SENTRY_DSN=
