#application configuration
VITE_APP_NAME=PA_ValueTech
VITE_APP_DESCRIPTION=Admin_Management_Portal
VITE_ENVIRONMENT=production

# Backend Configuration
# General backend origin - used by the Vite dev-server proxy (vite.config.js)
# and available app-wide via CREDENTIALS.BACKEND_URL. No trailing slash.
# Append :PORT here if you have a fixed port, or leave VITE_SERVER_PORT
# empty/unset when the URL already includes one.
VITE_BACKEND_URL=https://api.example.com
VITE_SERVER_PORT=

# Full API root used exclusively by src/constants/apiConfig.js to build every
# endpoint URL. No trailing slash (one is stripped automatically if present).
#
# DEPLOYMENT CONSTRAINT: the API sets its session cookie with
# SameSite=Strict (see the backend's src/constant/cookie-option.js), so this
# host and the host serving the frontend must share a registrable domain.
# Deployed cross-site the browser withholds the cookie on every request, and
# login appears to succeed and then 401s forever with nothing in the API logs.
#
# Production satisfies this — both are subdomains of nimitconsultancy.in:
#   frontend  https://pa.nimitconsultancy.in
#   API       https://paserver.nimitconsultancy.in/api/v1
#
# The matching requirement on the API side is that its ALLOWED_ORIGIN contains
# exactly https://pa.nimitconsultancy.in (no trailing slash — CORS compares
# origins literally). A missing entry fails the same silent way.
VITE_API_URL=https://api.example.com/api/v1

# A production build bakes VITE_API_URL into the bundle, so vite.config.js
# refuses to build for production when it points at localhost or plain http.
# Set this to true only to build a production bundle against a local API
# deliberately, e.g. for `npm run preview`.
ALLOW_INSECURE_API_URL=false

VITE_API_TIMEOUT=30000
VITE_ENV=production

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false

# Authentication is cookie-only: the backend sets an httpOnly session cookie
# that the browser attaches automatically (axios is created with
# withCredentials: true). There is deliberately no token in localStorage and no
# cookie name to configure here — the frontend never reads either one.

# Logging Level (development, staging, production)
VITE_LOG_LEVEL=error

# Where logger.warn/logger.error are POSTed, read by src/utils/errorReporter.js
# and installed in main.jsx at startup. Leave empty and nothing is reported —
# the reporter installs itself only when this is set, so switching reporting on
# is a config change rather than a code change.
#
# Payload: { level, message, data, timestamp, path, userAgent, release }.
# Credentials are omitted, and logger.js scrubs credentials and personal
# fields out of `data` before it is sent.
VITE_ERROR_REPORT_URL=

# Optional: error tracking DSN, for when a vendor is chosen. Swapping to
# Sentry means replacing the body of installErrorReporter (see the comment at
# the top of src/utils/errorReporter.js); nothing else in the app changes.
VITE_SENTRY_DSN=
