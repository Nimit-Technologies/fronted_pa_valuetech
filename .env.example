#application configuration
VITE_APP_NAME=PA_ValueTech
VITE_APP_DESCRIPTION=Admin_Management_Portal
VITE_ENVIRONMENT=production

# Backend Configuration
# Full origin, no trailing slash. Append :PORT here if you have a fixed port,
# or leave VITE_SERVER_PORT empty/unset when the URL already includes one.
VITE_BACKEND_URL=https://api.example.com
VITE_SERVER_PORT=
VITE_API_TIMEOUT=30000
# Optional: only needed if your backend routes are version-prefixed
# (e.g. api/v1). Leave empty when VITE_BACKEND_URL is the full API root.
VITE_API_VERSION=
VITE_ENV=production

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_ANALYTICS=true

# Authentication
VITE_AUTH_COOKIE_NAME=auth
VITE_AUTH_TOKEN_STORAGE=localStorage

# Logging Level (development, staging, production)
VITE_LOG_LEVEL=error

# Optional: error tracking DSN, read in src/utils/logger.js
VITE_SENTRY_DSN=
