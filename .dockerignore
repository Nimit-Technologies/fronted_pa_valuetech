# Version control
.git
.gitattributes
.gitignore

# Dependencies (installed fresh in the deps stage)
node_modules

# Build output
dist
dist-ssr

# Env files - pass values via --build-arg instead of baking a .env into the image
.env
.env.*
!.env.example

# Test artifacts / test sources not needed for the production build
coverage
playwright-report
test-results
tests

# Editor / tooling / agent metadata
.vscode
.idea
.agents
.claude
.shipstudio

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
# docker-compose.yaml (.yaml, not .yml) is generated by the deploy platform
# (e.g. Coolify) next to the checked-out source and isn't part of this repo -
# exclude it so it never gets copied into the image and linted by prebuild.
docker-compose.yaml

# Misc
*.log
README.md
